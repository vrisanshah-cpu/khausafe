# Copy this file to .env.local and fill in once a Supabase project exists.
# Until these are set, the app runs fine on the local JSON vendor seed —
# only auth, reviews, community observations, and admin stay disabled.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Powers /admin writes (add
# stall, sponsorship, review moderation). Get it from Supabase dashboard ->
# Project Settings -> API -> service_role key. Treat it like a master
# password to the whole database.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to sign in to /admin (must match a real
# Supabase Auth user, i.e. someone who's signed in via the magic-link flow
# at least once). Example: ADMIN_EMAILS=you@example.com,cofounder@example.com
ADMIN_EMAILS=
